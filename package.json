{
  "name": "jbot-website",
  "version": "3.0.85",
  "description": "Personal website for Joey Guerra",
  "main": "server.mjs",
  "dependencies": {
    "@devchitchat/index97": "^2.1.2",
    "dijkstrajs": "^1.0.3",
    "html-to-pdfmake": "^2.5.31",
    "pdfmake": "^0.2.20",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "test": "bun test",
    "start": "bun Server.mjs",
    "dev": "bun --watch Server.mjs",
    "docker-build": "./docker-build-k3s.sh",
    "local-deploy": "kubectl config use-context ${KUBE_CONTEXT:-k3s-local} && kubectl apply -f charts/web/deployment.yaml -n ${KUBE_NAMESPACE:-default}",
    "push": "bun run docker-build && bun run local-deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeyguerra/joeyguerra"
  },
  "keywords": [
    "joey",
    "guerra",
    "personal",
    "site"
  ],
